{
  "name": "yeonjae-studio",
  "version": "0.0.1",
  "private": true,
  "description": "Yeonjae Studio \u2014 English manuscripts in the Korean serialized-webnovel tradition. Monorepo root.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:replay-120": "node tools/run-longform-replay.mjs",
    "test:chaos": "node tools/run-chaos-drills.mjs",
    "drill:restore": "node tools/run-restore-drill.mjs",
    "drill:pitr": "node tools/run-pitr-rehearsal.mjs",
    "test:perf-smoke": "vitest run packages/db/src/perf-smoke.test.ts",
    "test:e2e-readiness": "vitest run packages/workflows/src/readiness-scenario.integration.test.ts",
    "test:security": "node tools/run-security-suite.mjs",
    "test:costs": "node tools/run-cost-suite.mjs",
    "gen:types": "tsx tools/gen-types.ts",
    "check:types-fresh": "tsx tools/gen-types.ts --check",
    "validate:planning": "python3 tools/validate-planning-package.py --quiet",
    "validate:contrast": "tsx packages/eval/src/main.ts",
    "generate:contrast-recordings": "tsx packages/eval/src/generate.ts",
    "cli": "tsx apps/cli/src/main.ts",
    "synthetic:provider": "tsx tools/run-synthetic-provider.ts",
    "provider:genspark": "python3 tools/genspark_provider_bridge.py",
    "provider:genspark:check": "curl -fsS http://127.0.0.1:8091/health",
    "check": "pnpm run check:types-fresh && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run test:replay-120 && pnpm run test:chaos && pnpm run drill:restore && pnpm run test:security && pnpm run test:costs && pnpm run build:web && pnpm run validate:planning && pnpm run validate:contrast",
    "build:web": "pnpm --filter @yeonjae/web build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11",
    "@vitejs/plugin-react": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
